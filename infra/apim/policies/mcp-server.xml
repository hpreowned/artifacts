<!-- MCP-server scope policy. T18 (STATUS.md, user decision): no shared key between APIM and intake-api.
     validate-azure-ad-token is still the authorization point (Entra group membership via assignment-required
     plus the audience/scp checks below), but APIM no longer hands intake-api a derived identity: it forwards
     the caller's own Authorization bearer unchanged (APIM's <base /> default; nothing here touches it or
     context.Request.Headers["Authorization"]) and intake-api verifies that same token itself against the
     tenant's JWKS and takes oid/upn from its claims (intake-api/src/entra-token.ts). The two
     X-Publisher-* set-header lines this policy used to add are gone; the explicit delete below is
     defense in depth so a caller cannot smuggle its own values for headers intake-api no longer reads
     anyway. {{...}} are APIM named values. -->
<policies>
  <inbound>
    <base />
    <rate-limit-by-key calls="60" renewal-period="60" counter-key="@(context.Request.IpAddress)" />
    <validate-azure-ad-token tenant-id="{{tenant-id}}" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized" output-token-variable-name="jwt">
      <audiences>
        <audience>{{artifacts-mcp-client-id}}</audience>
      </audiences>
      <client-application-ids>
        <application-id>{{claude-connector-client-id}}</application-id>
      </client-application-ids>
      <required-claims>
        <claim name="scp" match="any">
          <value>artifacts.publish</value>
        </claim>
      </required-claims>
    </validate-azure-ad-token>
    <set-header name="X-Publisher-Oid" exists-action="delete" />
    <set-header name="X-Publisher-Upn" exists-action="delete" />
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error>
    <base />
    <choose>
      <when condition="@(context.Response.StatusCode == 401)">
        <set-header name="WWW-Authenticate" exists-action="override">
          <value>Bearer resource_metadata="https://mcp.corp.com/.well-known/oauth-protected-resource/artifacts-mcp/mcp"</value>
        </set-header>
      </when>
    </choose>
  </on-error>
</policies>
