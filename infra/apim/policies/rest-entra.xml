<!-- Operation scope for the two REST operations that are also MCP tools (beginPublish, getPublishStatus)
     when called DIRECTLY over REST (artifactctl, CI). Same Entra validation as the MCP scope, so the
     REST path is never weaker than the tool path. No PRM header: REST callers already hold a token.
     UNVERIFIED (Phase 0): whether APIM re-runs operation policies when an MCP tool call is proxied to the
     operation. If tool calls start failing with 401 while direct REST works, the Authorization header is not
     being forwarded on that internal hop; see infra/apim/README.md. -->
<policies>
  <inbound>
    <base />
    <rate-limit-by-key calls="60" renewal-period="60" counter-key="@(context.Request.IpAddress)" />
    <validate-azure-ad-token tenant-id="{{tenant-id}}" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized" output-token-variable-name="jwt">
      <audiences>
        <audience>{{artifacts-mcp-client-id}}</audience>
      </audiences>
      <required-claims>
        <claim name="scp" match="any">
          <value>artifacts.publish</value>
        </claim>
      </required-claims>
    </validate-azure-ad-token>
    <set-header name="X-Publisher-Oid" exists-action="delete" />
    <set-header name="X-Publisher-Upn" exists-action="delete" />
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
