<!-- Operation scope for PUT /v1/publish/{jobId}/upload and POST /v1/publish/{jobId}/finalize.
     No Entra validation: the bearer is the one-time upload token and intake-api validates it.
     32 MiB request cap (33554432 bytes), rate limit keyed on the bearer token. T18: intake-api never
     reads X-Publisher-* headers at all any more (identity on these two routes comes from the job the
     authenticated beginPublish call already created, bound to the uploadToken); the delete below is
     defense in depth so a caller cannot smuggle values for a header nothing trusts. -->
<policies>
  <inbound>
    <base />
    <choose>
      <when condition="@(!context.Request.Headers.ContainsKey(&quot;Authorization&quot;))">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
        </return-response>
      </when>
    </choose>
    <rate-limit-by-key calls="30" renewal-period="60" counter-key="@(context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;, &quot;&quot;))" />
    <validate-content unspecified-content-type-action="ignore" max-size="33554432" size-exceeded-action="prevent" errors-variable-name="requestBodyValidation" />
    <set-header name="X-Publisher-Oid" exists-action="delete" />
    <set-header name="X-Publisher-Upn" exists-action="delete" />
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
