{
  "name": "intake-api",
  "version": "0.1.0",
  "private": true,
  "description": "Artifact intake API: begin/upload/finalize/status, pipeline events, view-token minting. See README.md.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/intake-api/src/main.js",
    "dev": "npm run build && node dist/intake-api/src/dev.js",
    "test": "npm run build && node --test dist/intake-api/src/test/*.test.js"
  },
  "dependencies": {
    "@azure/identity": "4.14.0",
    "@azure/service-bus": "7.10.0",
    "@azure/storage-blob": "12.34.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
