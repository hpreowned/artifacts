{
  "name": "static-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Serves scanned static artifacts from a read-only root, one origin per artifact, behind the viewer shell.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/server.js",
    "dev": "npm run build && node --enable-source-maps dist/src/server.js"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
