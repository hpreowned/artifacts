{
  "name": "viewer-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Entra-signed-in viewer page that audits the view, mints an artifact view token via intake-api and iframes the artifact origin.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/server.js",
    "dev": "npm run build && node --enable-source-maps dist/src/server.js"
  },
  "dependencies": {
    "@azure/msal-node": "7.1.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
